{
    "installCommand": "npm run install:all",
    "buildCommand": "npm run build --prefix frontend",
    "outputDirectory": "frontend/dist",
    "functions": {
        "api/index.mjs": {
            "runtime": "nodejs20.x"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.mjs"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
