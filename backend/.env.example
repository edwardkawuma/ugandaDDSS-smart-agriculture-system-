PORT=3001
GEE_PROJECT_ID=your-google-cloud-project-id
# Path to service account JSON with Earth Engine access (optional — demo mode without it)
GOOGLE_APPLICATION_CREDENTIALS=./gee-service-account.json

# Auth (change in production)
JWT_SECRET=agrismart-uganda-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# SerpApi Google Maps — https://serpapi.com/search?engine=google_maps
# Optional: without it, map search uses local Uganda district GeoJSON
SERPAPI_KEY=

# Sentinel Hub WMS proxy — https://www.sentinel-hub.com
# Create a free account, add a Configuration, and paste the Instance ID here
# Without it the proxy runs in demo mode (transparent placeholder tiles)
SENTINEL_INSTANCE_ID=
# OAuth2 credentials (optional — only needed for process API / batch exports)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Online sync — optional PostgreSQL (SQLite always used offline)
# DATABASE_URL=postgresql://user:password@localhost:5432/agrismart
# PG_SSL=false
# SYNC_INTERVAL_MS=15000

# Turso (libSQL) durable SQLite for serverless production
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Optional local file override for SQLite (when Turso is not configured)
# SQLITE_PATH=./data/agrismart-local.db